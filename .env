# Public build-time config (safe to commit — every VITE_* value ends up in the page).

# Absolute URL the site is served from. Used for canonical + Open Graph tags.
VITE_SITE_URL=https://elijah-klinkin.github.io/gleec-uk-landing-page/

# Staging copy on a personal domain: keep it out of search results.
# Switch to "index, follow" when the site moves to the corporate domain.
VITE_ROBOTS=noindex, nofollow

# Lead-intake API that receives the waitlist form (leads-api/ in this repo).
VITE_LEADS_ENDPOINT=
