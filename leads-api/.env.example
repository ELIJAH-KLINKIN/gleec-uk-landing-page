# Postgres connection string; injected automatically by Vercel's Neon integration.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Comma-separated exact origins allowed to POST (scheme + host + port, no trailing slash, no wildcards).
ALLOWED_ORIGINS=https://elijah-klinkin.github.io,http://localhost:5173,http://localhost:4173

# Secret salt for hashing client IPs (HMAC-SHA256); generate with: openssl rand -hex 32
IP_HASH_SALT=

# Telegram bot token from @BotFather (optional; empty = Telegram off).
TELEGRAM_BOT_TOKEN=

# Telegram channel/group id the bot posts to, e.g. -1001234567890 (optional; bot must be admin).
TELEGRAM_CHAT_ID=

# Forum topic id inside a group with topics enabled (optional).
TELEGRAM_THREAD_ID=

# CRM endpoint that receives signed lead.created webhooks (optional; empty = off).
CRM_WEBHOOK_URL=

# Shared secret for the X-Gleec-Signature HMAC; required whenever CRM_WEBHOOK_URL is set.
CRM_WEBHOOK_SECRET=
