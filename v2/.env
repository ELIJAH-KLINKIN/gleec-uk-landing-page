# Public build-time config (safe to commit — every VITE_* value ends up in the page).

# Absolute URL the site is served from. Used for canonical + Open Graph tags.
VITE_SITE_URL=https://gleec-uk-landing-page-v2.vercel.app/

# Staging: keep it out of search results. Switch to "index, follow" for launch.
VITE_ROBOTS=noindex, nofollow

# Lead-intake API that receives the waitlist form (../leads-api).
VITE_LEADS_ENDPOINT=
